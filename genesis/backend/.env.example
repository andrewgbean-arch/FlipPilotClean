# Copy to .env and adjust. Every setting is optional.
GENESIS_DATA_DIR=./data
GENESIS_OLLAMA_URL=http://127.0.0.1:11434
GENESIS_CHAT_MODEL=llama3.1:8b
# Tried in order if the chat model isn't installed:
GENESIS_FALLBACK_MODELS=["llama3","mistral","deepseek-r1:8b"]
GENESIS_EMBED_MODEL=nomic-embed-text
GENESIS_VISION_MODEL=llama3.2-vision
# Require this token in the X-Genesis-Token header (recommended if you expose the port beyond localhost):
# GENESIS_API_TOKEN=change-me
# Voice
GENESIS_WHISPER_MODEL=base.en
GENESIS_PIPER_VOICE=en_US-lessac-medium
# Extra folders the read_file tool may read (JSON list):
# GENESIS_FILE_TOOL_ROOTS=["/home/me/Documents/genesis"]
# Optional local web search via SearXNG:
# GENESIS_SEARXNG_URL=http://127.0.0.1:8888
GENESIS_LOG_LEVEL=INFO
