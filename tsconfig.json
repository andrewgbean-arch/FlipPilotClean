{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"],
      "~/*": ["app/*"],
      "@styles/*": ["src/styles/*"]
    },

    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["react", "react-native"]
  },

  "include": [
    "src",
    "app",
    "src/types/react-native.d.ts",
    "declarations.d.ts",
    "app/listing/analysis/[id].tsx"
, "src/components/DepreciationCurve.tsx", "app/dealer/DealerTools.tsx"  ]
}
