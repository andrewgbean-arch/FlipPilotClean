{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "*": ["*", "market-backend/*"]
    },

    "ignoreDeprecations": "5.0",
    "outDir": "dist"
  },

  "include": [
    "./**/*.ts",
    "market-backend/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
