{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*", "market-backend/*"]
    },
    "ignoreDeprecations": "6.0",
    "outDir": "dist"
  },
  "include": ["./**/*.ts", "market-backend/**/*"],
  "exclude": ["node_modules", "dist"]
}
