# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored: never commit it.

# The app's development fallback expects the backend on 3001 (the server's own default is 4000).
PORT=3001

# DVLA Vehicle Enquiry Service: registration -> make, model, colour, fuel, tax status, MOT expiry.
DVLA_API_KEY=

# DVSA MOT History API (OAuth2 client credentials). All five values come from your DVSA API registration.
API_KEY=
CLIENT_ID=
CLIENT_SECRET=
TOKEN_URL=
SCOPE_URL=

# Market data for scans.
OPENAI_API_KEY=
SERPAPI_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# RevenueCat's SECRET REST API key (RevenueCat dashboard > Project settings >
# API keys > Secret keys) — NOT the public SDK key already used in the app.
# Lets the backend confirm a device is really a paying Pro subscriber before
# exempting it from the free-scan weekly cap. Leave blank and every device is
# treated as not-Pro, same as before this existed.
REVENUECAT_SECRET_KEY=

# --- Hosting settings (all optional) ---

# Most lookups you can run per day across the whole server (they call paid services).
# When it is reached, scans answer "busy, try again later". Default 3000.
DAILY_LOOKUP_LIMIT=3000

# Set to 1 when the backend runs behind one proxy (Render, Fly, Heroku ...) so the
# per-caller limits see the real caller. Leave at 0 on your own network.
TRUST_PROXY_HOPS=0
