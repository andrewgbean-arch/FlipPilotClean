# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored: never commit it.

# The app's development fallback expects the backend on 3001 (the server's own default is 4000).
PORT=3001

# DVLA Vehicle Enquiry Service: registration -> make, model, colour, fuel, tax status, MOT expiry.
DVLA_API_KEY=

# DVSA MOT History API (OAuth2 client credentials). All five values come from your DVSA API registration.
API_KEY=
CLIENT_ID=
CLIENT_SECRET=
TOKEN_URL=
SCOPE_URL=

# Market data for scans.
OPENAI_API_KEY=
SERPAPI_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# RevenueCat's SECRET REST API key (RevenueCat dashboard > Project settings >
# API keys > Secret keys) — NOT the public SDK key already used in the app.
# Lets the backend confirm a device is really a paying Pro subscriber before
# exempting it from the free-scan weekly cap. Leave blank and every device is
# treated as not-Pro, same as before this existed.
REVENUECAT_SECRET_KEY=

# Export a FlipPilot listing to the seller's own eBay account. Separate from
# EBAY_CLIENT_ID/SECRET above, which only ever read public listings — this
# needs a DIFFERENT eBay app registration built for "sign in with eBay":
#   1. developer.ebay.com > sign in > Application Keys > create a Keyset
#      (Sandbox first for testing, Production once it's working).
#   2. In the same portal, User Tokens > "Get a Token from eBay via Your
#      Application" > set up a redirect (a "RuName"). It asks for three
#      URLs (Auth accepted / declined / privacy policy) — any real https
#      URL works for all three (they don't need to do anything; the app
#      intercepts the redirect before it matters what's actually there).
#   3. Paste the Keyset's Client ID and Client Secret below, and the exact
#      RuName string (not a URL — looks like "Your_Name-AppName-abc12345").
# Leave blank and eBay export just tells the user it isn't set up yet.
EBAY_SELL_CLIENT_ID=
EBAY_SELL_CLIENT_SECRET=
EBAY_SELL_RUNAME=
# The exact "Auth accepted" URL you registered in step 2 above (a real https
# URL) — the app watches for the browser reaching this exact page to know
# the sign-in finished, then reads the ?code= eBay appended to it.
EBAY_SELL_REDIRECT_URL=
# "sandbox" (default, for testing with a sandbox eBay account) or "production".
EBAY_SELL_ENV=sandbox
# REQUIRED for eBay export: a long random secret (32+ characters) used to encrypt
# each seller's eBay login before it is stored. Never commit it or lose it: if it
# changes, everyone has to reconnect eBay. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Marketplace admin: lets you read reports and flagged listings and remove a
# listing or boot fair (x-admin-token header). Leave blank to switch them off.
ADMIN_TOKEN=
# The public https address of this server, so photo links point at the right
# place behind a proxy (for example https://api.yourdomain.com). Optional locally.
PUBLIC_BASE_URL=
# The launch offer: until this date (ISO, for example 2026-12-01) listing is free for
# everyone. Set it when the app launches. Unset = the offer never ends, and the
# server warns you at startup. After it, a car costs 25 credits and items past 5 live cost credits.
MARKETPLACE_PROMO_ENDS_AT=
# A flood guard on new listings per device per 24 hours (default 30).
MAX_NEW_LISTINGS_PER_DAY=

# --- Hosting settings (all optional) ---

# Most lookups you can run per day across the whole server (they call paid services).
# When it is reached, scans answer "busy, try again later". Default 3000.
DAILY_LOOKUP_LIMIT=3000

# Set to 1 when the backend runs behind one proxy (Render, Fly, Heroku ...) so the
# per-caller limits see the real caller. Leave at 0 on your own network.
TRUST_PROXY_HOPS=0

# Adverts: an AI looks at each advert's wording and picture before it can be approved.
# "off" skips it (adverts then wait for a person, marked unchecked). Leave unset in production.
# ADVERT_AI_REVIEW=off

# Adverts: how many advertisers may share the marketplace feed in one area at one time (default 10).
# MAX_FEED_ADVERTS_PER_AREA=10

# Adverts: how many advertisers may share the scan full page in one area at one time (default 3).
# They take turns, so nobody is shown the same full page on every scan. Set 1 for exclusive.
# MAX_FULL_PAGE_PER_AREA=3

# Adverts: how many advertisers may share the Messages banner in one area at one time (default 10).
# MAX_MESSAGES_ADVERTS_PER_AREA=10

# The free 5-scans-a-week limit. ON by default when NODE_ENV=production and OFF otherwise, so
# real users always have it and testing on your own machine doesn't hit your own cap.
# Set on/off only to override that.
# FREE_SCAN_CAP=on

# Accounts: people sign in with their email and a one-time code (no passwords). The code is sent
# by Resend (resend.com). Both are needed in production, or nobody can sign in.
# RESEND_API_KEY=
# EMAIL_FROM=FlipPilot <sign-in@your-verified-domain.com>

# Selling, messaging, photo uploads and reporting need a signed-in account. ON by default when
# NODE_ENV=production and OFF otherwise, so the app can be tried without email. Set on/off to override.
# An id that already belongs to an account is protected either way.
# REQUIRE_ACCOUNT=on

# Testing only (ignored in production): AUTH_DEV_ECHO=1 returns the code in the reply;
# AUTH_CODE_TTL_MS and AUTH_RESEND_GAP_MS shorten the code life and the wait between codes.

# Scan credit packs are checked with RevenueCat, using REVENUECAT_SECRET_KEY (above). The pack product
# ids must be created as consumables in RevenueCat, App Store Connect and Google Play exactly as
# named in backend/utils/creditPacks.ts (flippilot_credits_25, _50, _100, _200).
# Testing only: point the purchase check at a pretend RevenueCat.
# REVENUECAT_API_BASE=http://localhost:4397

# What the paid services cost: GET /admin/costs (needs ADMIN_TOKEN) shows the day-by-day estimate, worked
# out from what the server really called. These are the prices it uses; change them if your plan differs
# or the estimate drifts from the real bills.
# OPENAI_INPUT_USD_PER_M=0.15
# OPENAI_OUTPUT_USD_PER_M=0.60
# SERPAPI_USD_PER_SEARCH=0.015
# USD_TO_GBP=0.75

# Google Shopping is the dearest part of a scan (a paid search each time). "always" (the default) searches on
# every scan; "when-needed" searches only when eBay did not find enough listings to price the item from.
# Turn it on once /admin/costs shows it is worth it: it can nudge some prices, as Google is one of the shelf-price sources.
# GOOGLE_SHOPPING=always
